MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=citizen_call_intelligence
TELEPHONY_MODE=simulation
EXOTEL_ACCOUNT_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_PHONE_NUMBER=
EXOTEL_API_BASE=https://api.in.exotel.com
# Required for production SMS to Indian numbers. Register the exact SMS bodies in DLT.
EXOTEL_DLT_TEMPLATE_ID=
PUBLIC_BASE_URL=https://your-public-url.example
# Speech-to-text: use local for Faster-Whisper or groq for Groq Whisper.
STT_PROVIDER=local
STT_LANGUAGE=
STT_MODEL_SIZE=base
GROQ_API_KEY=
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
HEAD_USERNAME=head
HEAD_PASSWORD=use-a-strong-head-password
DEPARTMENT_USERNAME=officer
DEPARTMENT_PASSWORD=use-a-strong-officer-password
DEPARTMENT_DEFAULT=Municipal Corporation & Sanitation
SIMULATOR_USERNAME=simulator
SIMULATOR_PASSWORD=use-a-strong-simulator-password
# Optional additional department accounts (single-line JSON):
# DEPARTMENT_ACCOUNTS_JSON={"pwd.officer":{"password":"strong-password","department":"Public Works (PWD) & Roads","name":"PWD Officer"}}
